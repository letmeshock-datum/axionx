---
import FeatureList from './FeatureList.astro';
import type { Section } from '../i18n/ui';

interface Props {
  section: Section;
  /** The first section carries the page h1. */
  primary?: boolean;
}
const { section: s, primary = false } = Astro.props;
const Heading = primary ? 'h1' : 'h2';
const titleId = `${s.id}-title`;
---

<section class:list={['section', { 'section--primary': primary }]} id={s.id} aria-labelledby={titleId}>
  <div class="section__head">
    <p class="section__eyebrow">{s.eyebrow}</p>
    <Heading class="section__title t-trim" id={titleId}>{s.title}</Heading>
    <p class="section__intro t-trim">{s.intro}</p>
  </div>
  <div class="section__list">
    <FeatureList items={s.items} label={s.title} />
  </div>
  <p class="section__subline">{s.subline}</p>
</section>

<style>
  .section {
    display: grid;
    grid-template-columns: minmax(0, 31.25rem) minmax(0, 1fr); /* 500px | list */
    grid-template-areas:
      'head list'
      'sub  list';
    grid-template-rows: auto 1fr;
    column-gap: 3.75rem;
    row-gap: 3rem;
    align-items: start;
    scroll-margin-top: 2rem;
  }

  .section__head { grid-area: head; }

  .section__list {
    grid-area: list;
    justify-self: end;
    width: 100%;
    max-width: 31.25rem;
    /* First rule sits level with the title: eyebrow chip 1.75rem + gap 1.5rem. */
    padding-top: 3.25rem;
  }

  .section__subline {
    grid-area: sub;
    align-self: end;
    max-width: 26rem;
    padding-inline-start: 1rem;
    border-inline-start: 0.125rem solid var(--c-accent);
    font-size: 1.1875rem; /* 19px */
    line-height: 1.35;
    letter-spacing: var(--tr-h);
    text-wrap: pretty;
  }

  /* Dark chip keeps the accent legible over the light lower end of the gradient. */
  .section__eyebrow {
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 0.375rem 0.625rem;
    border-radius: 999px;
    background: rgba(8, 8, 8, 0.55);
    font-family: var(--font-mono);
    font-size: 0.8125rem; /* 13px */
    line-height: 1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-accent);
  }

  .section__title {
    max-width: 31.25rem;
    font-size: 2.5rem; /* 40px */
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: var(--tr-h);
    text-wrap: balance;
  }

  .section__intro {
    max-width: 27rem;
    margin-top: 1.25rem;
    font-size: 0.9375rem; /* 15px */
    line-height: 1.6; /* 24px */
    letter-spacing: var(--tr);
    text-wrap: pretty;
  }

  :global([dir='rtl']) .section__eyebrow {
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    letter-spacing: 0;
    text-transform: none;
  }
  :global([dir='rtl']) .section__title { line-height: 1.35; }
  :global([dir='rtl']) .section__intro { line-height: 1.8; margin-top: 1rem; }
  :global([dir='rtl']) .section__subline { line-height: 1.7; }

  @media (max-width: 1023px) {
    .section {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'list'
        'sub';
      grid-template-rows: auto;
      row-gap: 2.5rem;
    }
    .section__list {
      justify-self: stretch;
      max-width: 36rem;
      padding-top: 0;
    }
    .section__intro { max-width: 32rem; }
  }

  @media (max-width: 767px) {
    .section { row-gap: 2.25rem; }
    .section__title { font-size: 2.25rem; }
    .section__intro { max-width: 100%; margin-top: 1rem; }
    .section__list { max-width: 100%; }
  }
</style>
