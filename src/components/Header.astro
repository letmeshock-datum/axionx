---
import { getRelativeLocaleUrl } from 'astro:i18n';
import logoEn from '../assets/landing/logo-nav.svg';
import logoAr from '../assets/landing/logo-nav-ar.svg';
import LanguageSwitch from './LanguageSwitch.astro';
import { SITE } from '../site.config';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const logo = locale === 'ar' ? logoAr : logoEn;
---

<header class="nav wrap">
  <a class="nav__brand" href={getRelativeLocaleUrl(locale, '/')} aria-label={d.a11y.home}>
    <img src={logo.src} width={logo.width} height={logo.height} alt="" class="nav__logo" data-locale={locale} />
  </a>
  <nav class="nav__links" aria-label={d.a11y.primary}>
    <a class="nav__link" href="#product">{d.nav.product}</a>
    <a class="nav__link" href="#spar">{d.nav.spar}</a>
    <a class="nav__link" href="#oversight">{d.nav.oversight}</a>
    <LanguageSwitch locale={locale} />
    <a class="btn nav__demo" aria-haspopup="dialog" aria-expanded="false" href={`mailto:${SITE.email}`}>{d.nav.demo}</a>
  </nav>
</header>

<style>
  /* Figma Nav 1338:2968 — aligned to the page gutters. */
  .nav {
    --ctl-h: 3rem; /* shared height of the language switch and the demo button */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.752rem; /* 12.03px */
    text-decoration: none;
  }

  /* Latin wordmark: 24.06 design px tall. The Arabic one runs 1.5× taller (its dots reach
     above and below the letters, so at equal height it reads small). */
  .nav__logo { width: auto; height: 1.504rem; }
  .nav__logo:is([data-locale='ar']) { height: 2.256rem; }

  .nav__links {
    display: flex;
    align-items: center;
    gap: 3rem; /* 48px */
  }

  .nav__link {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.875rem; /* 14px */
    letter-spacing: 0.02em; /* 0.28px */
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-dim); /* grey at rest */
    transition: color 0.2s var(--ease);
  }

  .nav__link:hover,
  .nav__link:focus-visible { color: var(--c-white); }

  .nav__link:dir(rtl) {
    font-family: var(--font-sans);
    font-size: 1rem;
    text-transform: none;
  }

  .nav__demo {
    height: var(--ctl-h);
    padding: 0 1.5rem;
    background: var(--c-text);
    color: #000;
    font-size: 1rem;
  }

  .nav__demo:hover { background: var(--c-white); }

  @media (max-width: 1023px) {
    .nav__link { display: none; }
    .nav__links { gap: 1.5rem; }
  }

  @media (max-width: 767px) {
    .nav { --ctl-h: 2.25rem; padding-block: 1rem; gap: 0.75rem; }
    .nav__logo { height: 1.2rem; }
    .nav__logo:is([data-locale='ar']) { height: 1.8rem; }
    .nav__links { gap: 0.5rem; }
    .nav__demo { padding: 0 0.875rem; font-size: 0.8125rem; }
  }

  /* Narrow phones: logo + language; the same CTA closes the page. */
  @media (max-width: 369px) {
    .nav__demo { display: none; }
  }
</style>
