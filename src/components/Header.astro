---
import { getRelativeLocaleUrl } from 'astro:i18n';
import logo from '../assets/landing/logo-nav.svg';
import { SITE } from '../site.config';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<header class="nav wrap">
  <a class="nav__brand" dir="ltr" href={getRelativeLocaleUrl(locale, '/')} aria-label={d.a11y.home}>
    <img src={logo.src} width={logo.width} height={logo.height} alt="" class="nav__logo" />
  </a>
  <nav class="nav__links" aria-label={d.a11y.primary}>
    <a class="nav__link" href="#product">{d.nav.product}</a>
    <a class="nav__link" href="#spar">{d.nav.spar}</a>
    <a class="nav__link" href="#oversight">{d.nav.oversight}</a>
    <a class="btn nav__demo" href={`mailto:${SITE.email}`}>{d.nav.demo}</a>
  </nav>
</header>

<style>
  /* Figma Nav 1338:2968 — aligned to the page gutters. */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1.5rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 0.752rem; /* 12.03px */
    text-decoration: none;
  }

  .nav__logo { width: 9.27rem; height: auto; } /* 148.3 × 24.06 */

  .nav__links {
    display: flex;
    align-items: center;
    gap: 3rem; /* 48px */
  }

  .nav__link {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.875rem; /* 14px */
    letter-spacing: 0.02em; /* 0.28px */
    text-transform: uppercase;
    text-decoration: none;
    color: var(--c-dim); /* grey at rest */
    transition: color 0.2s var(--ease);
  }

  .nav__link:hover,
  .nav__link:focus-visible { color: var(--c-white); }

  :global([dir='rtl']) .nav__link {
    font-family: var(--font-sans);
    font-size: 1rem;
    text-transform: none;
  }

  .nav__demo {
    padding: 1rem 1.5rem; /* 16 / 24 */
    background: var(--c-text);
    color: #000;
    font-size: 1rem;
  }

  .nav__demo:hover { background: var(--c-white); }

  @media (max-width: 1023px) {
    .nav__link { display: none; }
    .nav__links { gap: 1.5rem; }
  }

  @media (max-width: 767px) {
    .nav { padding-block: 1rem; gap: 1rem; }
    .nav__logo { width: 7.4rem; }
    .nav__links { gap: 1rem; }
    .nav__demo { padding: 0.625rem 0.875rem; font-size: 0.8125rem; }
  }

  /* Very narrow phones: logo only; the same CTA closes the page. */
  @media (max-width: 359px) {
    .nav__demo { display: none; }
  }
</style>
