---
/**
 * Animated backdrop: the exact Figma gradient as a base layer, three soft
 * colour fields that drift on a slow loop, and a scroll-linked parallax
 * (the gradient is taller than the viewport and gets "pulled" as you scroll).
 * Everything is transform-only, so it stays on the compositor.
 */
---

<div class="bg" aria-hidden="true" data-bg>
  <div class="bg__base"></div>
  <div class="bg__drift">
    <div class="bg__blob bg__blob--a"></div>
    <div class="bg__blob bg__blob--b"></div>
    <div class="bg__blob bg__blob--c"></div>
  </div>
</div>

<style>
  .bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    min-height: 100lvh;
    overflow: hidden;
    pointer-events: none;
    background: var(--c-bg);
    contain: strict;
  }

  /* Figma: Desktop - 1 fill */
  .bg__base {
    position: absolute;
    inset: 0;
    height: 130%;
    background: linear-gradient(
      180deg,
      #080808 0%,
      #0d0d0d 1.03%,
      #080808 5.31%,
      #030303 19.28%,
      #191f2e 35.32%,
      #424f73 57.24%,
      #7a8180 67.4%,
      #989793 77.01%,
      #a8a6a5 91.99%,
      #9f9f9d 100%
    );
    transform: translate3d(0, calc(var(--scroll-p, 0) * -23%), 0)
      scaleY(calc(1 + var(--overscroll, 0) * 0.12));
    transform-origin: 50% 0;
    will-change: transform;
  }

  .bg__drift {
    position: absolute;
    inset: -15%;
    transform: translate3d(0, calc(var(--scroll-y, 0px) * -0.12), 0);
    will-change: transform;
  }

  .bg__blob {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
  }

  .bg__blob--a {
    width: 70vmax;
    height: 70vmax;
    left: 25%;
    top: 30%;
    background: radial-gradient(circle, rgba(78, 96, 150, 0.5) 0%, rgba(78, 96, 150, 0) 62%);
    animation: drift-a 26s ease-in-out infinite alternate;
  }

  .bg__blob--b {
    width: 95vmax;
    height: 60vmax;
    left: -15%;
    top: 58%;
    background: radial-gradient(ellipse, rgba(182, 180, 178, 0.42) 0%, rgba(182, 180, 178, 0) 62%);
    animation: drift-b 34s ease-in-out infinite alternate;
  }

  .bg__blob--c {
    width: 60vmax;
    height: 60vmax;
    right: -12%;
    top: 8%;
    background: radial-gradient(circle, rgba(22, 28, 46, 0.95) 0%, rgba(22, 28, 46, 0) 62%);
    animation: drift-c 40s ease-in-out infinite alternate;
  }

  @keyframes drift-a {
    from { transform: translate3d(-8%, -6%, 0) scale(1); }
    to   { transform: translate3d(12%, 9%, 0) scale(1.18); }
  }
  @keyframes drift-b {
    from { transform: translate3d(6%, 4%, 0) scale(1.05); }
    to   { transform: translate3d(-10%, -8%, 0) scale(0.92); }
  }
  @keyframes drift-c {
    from { transform: translate3d(4%, 6%, 0) scale(1.1); }
    to   { transform: translate3d(-10%, -4%, 0) scale(0.9); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bg__blob { animation: none; }
    .bg__base, .bg__drift { transform: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const root = document.documentElement;
  let ticking = false;

  function update() {
    ticking = false;
    const y = window.scrollY;
    const max = root.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(Math.max(y / max, 0), 1) : 0;
    root.style.setProperty('--scroll-y', `${Math.max(y, 0)}px`);
    root.style.setProperty('--scroll-p', p.toFixed(4));
    // iOS rubber-band at the top: stretch the gradient instead of showing a hard edge.
    root.style.setProperty('--overscroll', y < 0 ? Math.min(-y / 160, 1).toFixed(3) : '0');
  }

  function onScroll() {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  }

  if (!reduce.matches) {
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
