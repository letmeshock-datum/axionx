---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Chevron from '../assets/chevron.svg';
import { locales, localeMeta, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const current = localeMeta[locale];
---

<details class="lang" data-lang>
  <summary class="lang__summary" aria-label={`${d.a11y.language}: ${current.label}`}>
    <span class="lang__current">{current.label}</span>
    <Chevron class="lang__chevron" aria-hidden="true" focusable="false" />
  </summary>
  <ul class="lang__menu" role="list">
    {
      locales.map((l) => (
        <li>
          <a
            class="lang__item"
            href={getRelativeLocaleUrl(l, '/')}
            hreflang={localeMeta[l].hreflang}
            lang={localeMeta[l].htmlLang}
            dir={localeMeta[l].dir}
            aria-current={l === locale ? 'page' : undefined}
          >
            {localeMeta[l].label}
          </a>
        </li>
      ))
    }
  </ul>
</details>

<style>
  .lang {
    position: relative;
  }

  .lang__summary {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    cursor: pointer;
    font-size: 0.875rem;
    line-height: 1.125rem;
    letter-spacing: var(--tr);
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
  }

  .lang__summary::-webkit-details-marker {
    display: none;
  }

  .lang__chevron {
    display: block;
    width: 0.375rem; /* 6px */
    height: auto;
    margin-top: 0.0625rem;
    transition: transform 0.25s var(--ease);
  }

  .lang[open] .lang__chevron {
    transform: rotate(180deg);
  }

  .lang__menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.625rem);
    z-index: 5;
    min-width: 8.5rem;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border-radius: 0.875rem;
    background: rgba(18, 18, 18, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(1.25rem);
    backdrop-filter: blur(1.25rem);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.35);
    animation: lang-in 0.2s var(--ease);
  }

  @keyframes lang-in {
    from { opacity: 0; transform: translateY(-0.25rem); }
    to   { opacity: 1; transform: none; }
  }

  .lang__item {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.625rem;
    font-size: 0.875rem;
    line-height: 1.125rem;
    text-decoration: none;
    text-align: start;
    white-space: nowrap;
    transition: background-color 0.2s var(--ease);
  }

  .lang__item:hover,
  .lang__item:focus-visible {
    background: rgba(255, 255, 255, 0.1);
  }

  .lang__item[aria-current='page'] {
    color: var(--c-accent);
  }
</style>

<script>
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-lang]');

  document.addEventListener('click', (event) => {
    for (const menu of menus) {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (menu.open) {
        menu.open = false;
        menu.querySelector<HTMLElement>('summary')?.focus();
      }
    }
  });
</script>
