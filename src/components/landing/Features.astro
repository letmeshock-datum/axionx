---
import { Image } from 'astro:assets';
import pattern from '../../assets/landing/pattern-overlay.png';
import dialog01 from '../../assets/landing/dialog-01.png';
import dialog02 from '../../assets/landing/dialog-02.png';
import dialog03 from '../../assets/landing/dialog-03.png';
import dialog04 from '../../assets/landing/dialog-04.png';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
const dialogs = [dialog01, dialog02, dialog03, dialog04];
---

<!--
  Scroll-driven 3D carousel (after Codrops "3D Carousel", MIT; Figma 1338:2997 + dialogs 1340:6558).
  Desktop: the block pins; the scroll turns a ring of four Axsi dialogs (90° apart) through 275°.
  The panel facing the viewer is sharp, the rest blur and dim with their angle; the matching card
  on the left lights. Below 1024px: no pinning, the dialogs swipe horizontally and drive the cards.
-->
<section class="fx" data-fx aria-label={d.features.label}>
  <div class="fx__pin wrap">
    <ul class="fx__cards">
      {
        d.features.items.map((f, i) => (
          <li>
            <button
              type="button"
              class:list={['card', { 'is-active': i === 0 }]}
              data-fx-card={i}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <span class="card__title">{f.title}</span>
              <span class="card__body">{f.body}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="fx__panel">
      <Image src={pattern} alt="" widths={[1440, 2560]} sizes="100vw" class="fx__pattern" />
      <div class="fx__viewport" data-fx-viewport dir="ltr">
        <ol class="fx__ring" data-fx-ring>
          {
            dialogs.map((img, i) => (
              <li class:list={['fx__cell', { 'is-active': i === 0 }]} data-fx-dialog={i} style={`--a: ${i * 90}deg`}>
                <span class="slab" style="--z: -4px" aria-hidden="true" />
                <span class="slab" style="--z: -3px" aria-hidden="true" />
                <span class="slab" style="--z: -2px" aria-hidden="true" />
                <span class="slab" style="--z: -1px" aria-hidden="true" />
                <figure class="dialog">
                  <Image
                    src={img}
                    alt={d.features.dialogAlt[i]}
                    widths={[372, 744]}
                    sizes="23.25rem"
                    class="dialog__img"
                    loading={i < 2 ? 'eager' : 'lazy'}
                  />
                </figure>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .fx {
    --panel-h: 41.75rem; /* 668px */
    --card-w: 23.4266rem; /* 374.83px dialog */
    --r: 24rem; /* ring radius */
    position: relative;
    /* Pinned travel: the ring turns 275° over ~3 viewports of scroll. */
    height: calc(var(--panel-h) + 3 * 75svh);
  }

  .fx__pin {
    position: sticky;
    top: max(1rem, calc(50svh - var(--panel-h) / 2));
    display: flex;
    align-items: center;
    gap: 4.3125rem; /* 69px */
  }

  .fx__cards {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    flex: none;
    width: 22.9375rem; /* 367px */
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    padding: 1.5rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    text-align: start;
    cursor: pointer;
    transition: background-color 0.35s var(--ease);
  }

  .card.is-active { background: var(--c-surface-muted); }

  @media (hover: hover) {
    .card:not(.is-active):hover { background: var(--c-surface-subtle); }
  }

  .card__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em; /* Geist runs wider than Diatype; keeps titles on one line */
    color: var(--c-white);
  }

  .card__body {
    font-size: 1rem;
    line-height: 1.4;
    color: var(--c-muted);
    text-wrap: pretty;
  }

  /* 1338:3019 — warm gradient panel that frames and clips the ring. */
  .fx__panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: var(--panel-h);
    border-radius: 0.5rem;
    overflow: hidden;
    isolation: isolate;
    background: linear-gradient(
      180deg,
      rgb(177, 100, 60) 0%,
      rgb(177, 98, 57) 21.879%,
      rgb(163, 87, 50) 30.783%,
      rgb(106, 49, 29) 55.901%,
      rgb(7, 6, 4) 88.296%,
      rgb(16, 16, 15) 92.349%,
      rgb(110, 108, 105) 117.45%
    );
  }

  .fx__pattern {
    position: absolute;
    right: 0;
    top: calc(50% + 0.75rem);
    width: 90rem;
    max-width: none;
    height: 50.625rem;
    translate: 0 -50%;
    object-fit: cover;
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: -1;
  }

  .fx__viewport {
    position: absolute;
    inset: 0;
    perspective: 64rem; /* ≈ 900px */
    perspective-origin: 50% 30%;
  }

  /* The ring: pulled back by its radius so the front panel lands at true size. */
  .fx__ring {
    position: absolute;
    top: 1.5rem;
    left: calc(50% - var(--card-w) / 2);
    width: var(--card-w);
    height: 56.375rem;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r) * -1)) rotateX(var(--tilt, 0deg)) rotateZ(var(--tilt, 0deg))
      rotateY(var(--rot, 0deg));
    will-change: transform;
  }

  /* Each cell sits on the ring, then turns part-way back towards the viewer (--turn, set per
     frame) so the neighbours show their faces instead of an edge. */
  .fx__cell {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateY(var(--a)) translateZ(var(--r)) rotateY(var(--turn, 0deg));
  }

  /* Glass card, as in Figma: translucent black over a strong backdrop blur. */
  .dialog,
  .slab {
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    filter: blur(var(--blur, 0px)) brightness(var(--dim, 1));
    opacity: var(--vis, 1);
  }

  .dialog {
    border: 0;
    background: rgba(0, 0, 0, 0.4);
    -webkit-backdrop-filter: blur(6.25rem);
    backdrop-filter: blur(6.25rem); /* 100px */
    box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    backface-visibility: hidden;
  }

  /* Figma 1340:6776 stroke: 1px inside, linear gradient top → bottom,
     #e88652 → rgba(43, 15, 0, 0). Drawn as a masked ring so it follows the radius. */
  .dialog::before,
  .slab {
    background: linear-gradient(180deg, #e88652 0%, rgba(43, 15, 0, 0) 100%);
    padding: 1px;
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }

  .dialog::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    pointer-events: none;
  }

  /* 4px extrusion: stacked 1px gradient outlines behind the face read as a solid edge when
     the card turns, without filling the glass from inside. */
  .slab {
    transform: translateZ(var(--z));
  }

  .dialog__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Below desktop: swipe carousel, no pinning, no 3D ---------- */
  @media (max-width: 1023px) {
    .fx { height: auto; --panel-h: 36rem; }
    .fx__pin {
      position: static;
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 1.5rem;
    }
    .fx__cards {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .card { height: 100%; padding: 1.25rem; }
    .fx__panel { flex: none; }

    .fx__viewport {
      perspective: none;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .fx__viewport::-webkit-scrollbar { display: none; }

    .fx__ring {
      position: static;
      display: flex;
      gap: 1rem;
      width: max-content;
      height: auto;
      padding: 1.5rem calc(50% - 9.25rem) 0;
      transform: none;
      transform-style: flat;
    }
    .fx__cell {
      position: static;
      flex: none;
      width: 18.5rem;
      transform: none;
      scroll-snap-align: center;
      opacity: 0.45;
      transition: opacity 0.4s var(--ease);
    }
    .fx__cell.is-active { opacity: 1; }
    .slab { display: none; }
    .dialog { position: relative; height: 44.6rem; filter: none; opacity: 1; }
  }

  @media (max-width: 767px) {
    .fx { --panel-h: 31rem; }
    .fx__cards { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; }
  }
</style>

<script>
  const desktop = window.matchMedia('(min-width: 1024px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const TURN = 275; // degrees over the whole pinned travel
  const STEP = 90; // degrees between dialogs
  const SHARP = 8; // within this many degrees of the front a panel is fully in focus
  const FACE = 0.62; // share of its ring angle a card turns back towards the viewer

  // Scroll progress → ring angle. Each panel dwells facing the viewer for a stretch of scroll,
  // then the ring eases to the next one; the last 5° of the 275° turn drift in at the very end.
  const ease = (x: number) => x * x * (3 - 2 * x);
  function angleFor(p: number) {
    const turns = 3; // 0° → 270°
    const main = Math.min(p / 0.92, 1) * turns;
    const i = Math.min(Math.floor(main), turns - 1);
    const f = main - i;
    const hold = 0.28; // share of each step spent dwelling at each end
    const g = f <= hold ? 0 : f >= 1 - hold ? 1 : ease((f - hold) / (1 - 2 * hold));
    const tail = Math.max(0, (p - 0.92) / 0.08) * (TURN - turns * STEP);
    return -((i + g) * STEP + tail);
  }
  // Inverse for card clicks: the middle of panel i's dwell.
  const progressFor = (i: number) => (i / 3) * 0.92;

  for (const root of document.querySelectorAll<HTMLElement>('[data-fx]')) {
    const pin = root.querySelector<HTMLElement>('.fx__pin')!;
    const ring = root.querySelector<HTMLElement>('[data-fx-ring]')!;
    const viewport = root.querySelector<HTMLElement>('[data-fx-viewport]')!;
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-fx-card]')];
    const cells = [...root.querySelectorAll<HTMLElement>('[data-fx-dialog]')];

    let active = 0;
    let rot = 0; // rendered angle
    let target = 0; // angle the scroll asks for
    let raf = 0;
    let inView = false;

    function setActive(i: number) {
      if (i === active) return;
      active = i;
      cards.forEach((c, k) => {
        c.classList.toggle('is-active', k === i);
        c.setAttribute('aria-current', String(k === i));
      });
      cells.forEach((c, k) => c.classList.toggle('is-active', k === i));
    }

    const travel = () => Math.max(1, root.offsetHeight - pin.offsetHeight);
    const stickyTop = () => parseFloat(getComputedStyle(pin).top) || 0;
    const progress = () =>
      Math.min(Math.max((stickyTop() - root.getBoundingClientRect().top) / travel(), 0), 1);

    // Paint the ring at `rot`: tilt, per-panel blur/dim by angle from the front, active card.
    function paint() {
      const p = progress();
      ring.style.setProperty('--rot', `${rot.toFixed(2)}deg`);
      ring.style.setProperty('--tilt', `${(2.5 - 5 * p).toFixed(2)}deg`);
      let best = 0;
      let bestDist = Infinity;
      cells.forEach((cell, k) => {
        const a = (((k * STEP + rot) % 360) + 540) % 360 - 180; // −180…180, 0 = facing the viewer
        const dist = Math.abs(a);
        if (dist < bestDist) { bestDist = dist; best = k; }
        const f = Math.min(Math.max(dist - SHARP, 0) / (70 - SHARP), 1);
        const vis = dist <= 105 ? 1 : Math.max(0, 1 - (dist - 105) / 30); // far side fades out
        cell.style.setProperty('--turn', `${(-FACE * a).toFixed(2)}deg`);
        cell.style.setProperty('--blur', `${(f * 8).toFixed(2)}px`);
        cell.style.setProperty('--dim', (1 - 0.3 * f).toFixed(3));
        cell.style.setProperty('--vis', vis.toFixed(3));
      });
      setActive(best);
    }

    // Ease the rendered angle towards the scroll's angle (a light scrub, like ScrollSmoother).
    // Time-based, so it catches up at the same pace at any frame rate.
    let last = 0;
    function frame(now: number) {
      raf = 0;
      if (!desktop.matches) return;
      target = angleFor(progress());
      const dt = last ? Math.min(now - last, 250) : 16;
      last = now;
      const delta = target - rot;
      const k = 1 - Math.exp(-dt / 110); // ~110 ms time constant
      rot = reduce.matches || Math.abs(delta) < 0.05 ? target : rot + delta * k;
      paint();
      if (inView && rot !== target) raf = requestAnimationFrame(frame);
      else last = 0;
    }
    const kick = () => { if (!raf && desktop.matches) raf = requestAnimationFrame(frame); };

    // Below desktop: the centred dialog in the swipe carousel wins.
    function fromSwipe() {
      if (desktop.matches) return;
      const mid = viewport.getBoundingClientRect().left + viewport.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      cells.forEach((c, k) => {
        const r = c.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - mid);
        if (dist < bestDist) { bestDist = dist; best = k; }
      });
      setActive(best);
    }

    cards.forEach((card, i) => {
      card.addEventListener('click', () => {
        if (desktop.matches) {
          const top = window.scrollY + root.getBoundingClientRect().top - stickyTop();
          window.scrollTo({ top: top + travel() * progressFor(i), behavior: 'smooth' });
        } else {
          const c = cells[i]!;
          viewport.scrollTo({ left: c.offsetLeft - (viewport.clientWidth - c.offsetWidth) / 2, behavior: 'smooth' });
          setActive(i);
        }
      });
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        inView = !!e?.isIntersecting;
        if (inView) kick();
      }, { rootMargin: '20% 0px' }).observe(root);
    } else {
      inView = true;
    }

    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick, { passive: true });
    viewport.addEventListener('scroll', () => requestAnimationFrame(fromSwipe), { passive: true });
    viewport.addEventListener('scrollend', fromSwipe);
    desktop.addEventListener('change', () => {
      if (desktop.matches) { rot = target = angleFor(progress()); paint(); }
      else {
        cells.forEach((c) => ['--blur', '--dim', '--vis', '--turn'].forEach((v) => c.style.removeProperty(v)));
        fromSwipe();
      }
    });

    if (desktop.matches) { rot = target = angleFor(progress()); paint(); }
  }
</script>
