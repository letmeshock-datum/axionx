---
import { Image } from 'astro:assets';
import pattern from '../../assets/landing/pattern-overlay.png';
import dialog01 from '../../assets/landing/dialog-01.png';
import dialog02 from '../../assets/landing/dialog-02.png';
import dialog03 from '../../assets/landing/dialog-03.png';
import dialog04 from '../../assets/landing/dialog-04.png';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
const dialogs = [dialog01, dialog02, dialog03, dialog04];
---

<!--
  Scroll-driven carousel (Figma 1338:2997 + dialogs 1340:6558).
  Desktop: the block pins while the page scrolls; each quarter of the travel
  activates the next card and slides the next Axsi dialog to the centre.
  Below 1024px: no pinning, the dialogs swipe horizontally and drive the cards.
-->
<section class="fx" data-fx aria-label={d.features.label}>
  <div class="fx__pin wrap">
    <ul class="fx__cards">
      {
        d.features.items.map((f, i) => (
          <li>
            <button
              type="button"
              class:list={['card', { 'is-active': i === 0 }]}
              data-fx-card={i}
              aria-current={i === 0 ? 'true' : 'false'}
            >
              <span class="card__title">{f.title}</span>
              <span class="card__body">{f.body}</span>
            </button>
          </li>
        ))
      }
    </ul>

    <div class="fx__panel">
      <Image src={pattern} alt="" widths={[1440, 2560]} sizes="100vw" class="fx__pattern" />
      <div class="fx__viewport" data-fx-viewport dir="ltr">
        <ol class="fx__track" data-fx-track>
          {
            dialogs.map((img, i) => (
              <li class:list={['dialog', { 'is-active': i === 0 }]} data-fx-dialog={i} data-pos={Math.min(i, 2)}>
                <Image
                  src={img}
                  alt={d.features.dialogAlt[i]}
                  widths={[372, 744]}
                  sizes="23.25rem"
                  class="dialog__img"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  /* Pin travel: one step ≈ 70% of the viewport per extra card. */
  .fx {
    --panel-h: 41.75rem; /* 668px */
    position: relative;
    height: calc(var(--panel-h) + 3 * 70svh);
  }

  .fx__pin {
    position: sticky;
    top: max(1rem, calc(50svh - var(--panel-h) / 2));
    display: flex;
    align-items: center;
    gap: 4.3125rem; /* 69px */
  }

  .fx__cards {
    display: flex;
    flex-direction: column;
    gap: 0.5rem; /* 8px between cards (Figma: 367 × 520 hug) */
    flex: none;
    width: 22.9375rem; /* 367px */
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    padding: 1.5rem;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    text-align: start;
    cursor: pointer;
    transition: background-color 0.35s var(--ease);
  }

  .card.is-active { background: var(--c-surface-muted); }

  @media (hover: hover) {
    .card:not(.is-active):hover { background: var(--c-surface-subtle); }
  }

  .card__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em; /* Geist runs wider than Diatype; keeps titles on one line */
    color: var(--c-white);
  }

  .card__body {
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: -0.015em; /* Geist runs wider than Diatype; keeps the design's two lines */
    color: var(--c-muted);
    text-wrap: pretty;
  }

  /* 1338:3019 — warm gradient panel that clips the dialogs. */
  .fx__panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: var(--panel-h);
    border-radius: 0.5rem;
    overflow: hidden;
    isolation: isolate;
    /* Backdrop root: card glass samples only what is inside the panel, so the page's black
       doesn't bleed into the blur along the left and right edges. */
    clip-path: inset(0 round 0.5rem);
    background: linear-gradient(
      180deg,
      rgb(177, 100, 60) 0%,
      rgb(177, 98, 57) 21.879%,
      rgb(163, 87, 50) 30.783%,
      rgb(106, 49, 29) 55.901%,
      rgb(7, 6, 4) 88.296%,
      rgb(16, 16, 15) 92.349%,
      rgb(110, 108, 105) 117.45%
    );
  }

  .fx__pattern {
    position: absolute;
    right: 0;
    top: calc(50% + 0.75rem);
    width: 90rem;
    max-width: none;
    height: 50.625rem;
    translate: 0 -50%;
    object-fit: cover;
    mix-blend-mode: overlay;
    pointer-events: none;
    z-index: -1;
  }

  /* Coverflow: no shared 3D scene. Every card carries its own transform (shift, scale and a
     slight turn with its own perspective) picked by data-pos (−2…2 from the front), and the
     stacking order is explicit — nothing is culled or re-sorted by the browser, so cards
     never drop out mid-transition. */
  .fx__viewport {
    position: absolute;
    inset: 0;
  }

  .fx__track {
    position: absolute;
    top: 1.5rem;
    left: calc(50% - 11.7133rem);
    width: 23.4266rem;
    height: 56.375rem;
  }

  /* Every card wears the same painted glass: the panel is a plain vertical gradient, so the
     Figma glass (40% black over a heavy backdrop blur) equals that gradient under 40% black
     (stops mapped from the panel onto the card). One background for every position means
     nothing jumps when a card changes place — only transform, blur and content opacity move,
     all on the same 0.8s curve. It also avoids backdrop-blur seams at the clipped panel edges
     and keeps the panel's glyph texture from showing through. */
  .dialog {
    --x: 0rem;
    --s: 1;
    --ry: 0deg;
    --blur: 0px;
    --fade: 1;
    position: absolute;
    inset: 0;
    width: 23.4266rem; /* 374.83px */
    border-radius: 1.5rem;
    background:
      linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)),
      linear-gradient(180deg, rgb(177, 100, 60) -2.66%, rgb(177, 98, 57) 13.54%, rgb(163, 87, 50) 20.14%, rgb(106, 49, 29) 38.74%, rgb(7, 6, 4) 62.73%, rgb(16, 16, 15) 65.73%, rgb(110, 108, 105) 84.32%);
    box-shadow: inset 0 0 2px rgba(0, 0, 0, 0.25);
    overflow: hidden;
    transform-origin: 50% 20%;
    transform: translateX(var(--x)) perspective(64rem) rotateY(var(--ry)) scale(var(--s));
    filter: blur(var(--blur));
    transition:
      transform 0.8s var(--ease),
      filter 0.8s var(--ease),
      opacity 0.8s var(--ease);
    will-change: transform, filter, opacity;
  }

  .dialog__img,
  .dialog::before {
    opacity: var(--fade);
    transition: opacity 0.8s var(--ease);
  }

  /* Front: sharp. */
  .dialog[data-pos='0'] { z-index: 3; }

  /* Neighbours: ~56px clear of the front card, turned slightly inwards, content at 50%,
     the whole tile out of focus (Figma had 10px; doubled on request). */
  .dialog[data-pos='-1'],
  .dialog[data-pos='1'] {
    z-index: 2;
    --s: 0.86;
    --blur: 20px;
    --fade: 0.5;
  }
  .dialog[data-pos='-1'] { --x: -24.5rem; --ry: 22deg; }
  .dialog[data-pos='1'] { --x: 24.5rem; --ry: -22deg; }

  /* Further out: parked beyond the neighbours, still blurred, faded out. */
  .dialog[data-pos='-2'],
  .dialog[data-pos='2'] {
    z-index: 1;
    --s: 0.74;
    --blur: 20px;
    --fade: 0.5;
    opacity: 0;
    pointer-events: none;
  }
  .dialog[data-pos='-2'] { --x: -44rem; --ry: 30deg; }
  .dialog[data-pos='2'] { --x: 44rem; --ry: -30deg; }

  /* Figma 1340:6776 stroke: 1px inside, linear gradient top → bottom,
     #e88652 → rgba(43, 15, 0, 0). Drawn as a masked ring so it follows the radius. */
  .dialog::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(180deg, #e88652 0%, rgba(43, 15, 0, 0) 100%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
    pointer-events: none;
  }

  .dialog__img {
    display: block;
    width: 100%;
    height: 56.375rem; /* 902px — the panel crops the bottom */
    object-fit: cover;
  }

  /* ---------- Below desktop: swipe carousel, no pinning ---------- */
  @media (max-width: 1023px) {
    .fx { height: auto; --panel-h: 36rem; }
    .fx__pin {
      position: static;
      flex-direction: column-reverse;
      align-items: stretch;
      gap: 1.5rem;
    }
    .fx__cards {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem;
    }
    .card { height: 100%; padding: 1.25rem; }
    .fx__panel { flex: none; }

    .fx__viewport {
      perspective: none;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .fx__viewport::-webkit-scrollbar { display: none; }

    .fx__track {
      position: static;
      display: flex;
      width: max-content;
      height: auto;
      padding: 1.5rem calc(50% - 9.25rem) 0;
      gap: 1rem;
      transform: none;
      transform-style: flat;
      transition: none;
    }
    .dialog,
    .dialog[data-pos] {
      position: relative;
      inset: auto;
      flex: none;
      transform: none;
      z-index: auto;
      pointer-events: auto;
      width: 18.5rem;
      scroll-snap-align: center;
      filter: none;
      --fade: 1;
      /* Flat swipe strip: real glass is safe here (no clipped 3D edges). */
      background: rgba(0, 0, 0, 0.4);
      -webkit-backdrop-filter: blur(6.25rem);
      backdrop-filter: blur(6.25rem);
      opacity: 0.45;
      transition: opacity 0.4s var(--ease);
    }
    .dialog.is-active,
    .dialog.is-active[data-pos] { opacity: 1; }
    .dialog__img { height: 44.6rem; }
  }

  @media (max-width: 767px) {
    .fx { --panel-h: 31rem; }
    .fx__cards { grid-template-columns: minmax(0, 1fr); gap: 0.25rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .fx__track, .dialog { transition: none; }
  }
</style>

<script>
  const desktop = window.matchMedia('(min-width: 1024px)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-fx]')) {
    const pin = root.querySelector<HTMLElement>('.fx__pin')!;
    const track = root.querySelector<HTMLElement>('[data-fx-track]')!;
    const viewport = root.querySelector<HTMLElement>('[data-fx-viewport]')!;
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-fx-card]')];
    const dialogs = [...root.querySelectorAll<HTMLElement>('[data-fx-dialog]')];
    const count = dialogs.length;
    let active = 0;
    let ticking = false;

    function setActive(i: number) {
      if (i === active) return;
      active = i;
      cards.forEach((c, k) => {
        c.classList.toggle('is-active', k === i);
        c.setAttribute('aria-current', String(k === i));
      });
      dialogs.forEach((dl, k) => {
        dl.classList.toggle('is-active', k === i);
        dl.dataset.pos = String(Math.max(-2, Math.min(2, k - i)));
      });
    }

    // Desktop: map the pinned travel onto 0..count-1.
    function travel() {
      return Math.max(1, root.offsetHeight - pin.offsetHeight);
    }
    function stickyTop() {
      return parseFloat(getComputedStyle(pin).top) || 0;
    }
    function fromScroll() {
      ticking = false;
      if (!desktop.matches) return;
      const progress = (stickyTop() - root.getBoundingClientRect().top) / travel();
      const p = Math.min(Math.max(progress, 0), 0.9999);
      setActive(Math.floor(p * count));
    }

    // Below desktop: the centred dialog in the swipe carousel wins.
    function fromSwipe() {
      if (desktop.matches) return;
      const mid = viewport.getBoundingClientRect().left + viewport.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      dialogs.forEach((dl, k) => {
        const r = dl.getBoundingClientRect();
        const dist = Math.abs(r.left + r.width / 2 - mid);
        if (dist < bestDist) { bestDist = dist; best = k; }
      });
      setActive(best);
    }

    cards.forEach((card, i) => {
      card.addEventListener('click', () => {
        if (desktop.matches) {
          const top = window.scrollY + root.getBoundingClientRect().top - stickyTop();
          window.scrollTo({ top: top + travel() * ((i + 0.5) / count), behavior: 'smooth' });
        } else {
          const dl = dialogs[i]!;
          viewport.scrollTo({
            left: dl.offsetLeft - (viewport.clientWidth - dl.offsetWidth) / 2,
            behavior: 'smooth',
          });
        }
        setActive(i);
      });
    });

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(fromScroll);
        }
      },
      { passive: true },
    );
    viewport.addEventListener('scroll', () => requestAnimationFrame(fromSwipe), { passive: true });
    viewport.addEventListener('scrollend', fromSwipe);
    desktop.addEventListener('change', () => {

      desktop.matches ? fromScroll() : fromSwipe();
    });
    window.addEventListener('resize', () => requestAnimationFrame(fromScroll), { passive: true });
    fromScroll();
  }
</script>
