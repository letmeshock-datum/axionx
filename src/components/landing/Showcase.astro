---
import { Image } from 'astro:assets';
import backdrop from '../../assets/landing/media-backdrop.jpg';
import AsciiField from './AsciiField.astro';
import dashboard from '../../assets/landing/dashboard-ui.png';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
---

<section class="showcase wrap" id="product">
  <div class="showcase__frame" data-tilt>
    <Image src={backdrop} alt="" widths={[800, 1280, 2000, 2560]} sizes="(min-width: 1024px) 88.9vw, 100vw" class="showcase__backdrop" loading="eager" />
    <div class="showcase__blur" aria-hidden="true"></div>
    <AsciiField src={backdrop} amount={0.05} class="showcase__ascii" />
    <div class="showcase__glass" data-tilt-card>
      <Image
        src={dashboard}
        alt={d.showcase.alt}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 1024px) 61vw, 92vw"
        class="showcase__shot"
        loading="eager"
        fetchpriority="high"
      />
      <span class="showcase__glare" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  /* Figma 1338:2989 / Frame 56 1338:2990 — 1280 × 693, radius 8, padding 88/200. */
  .showcase__frame {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    aspect-ratio: 1280 / 693;
    padding: 5.5rem 12.5rem;
    border-radius: 0.5rem;
    overflow: hidden;
    isolation: isolate;
  }

  .showcase__backdrop,
  .showcase__blur {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .showcase__backdrop { object-fit: cover; z-index: -3; }

  /* 1338:2991: 200px backdrop blur over the photo. */
  .showcase__blur {
    z-index: -2;
    background: rgba(217, 217, 217, 0.01);
    -webkit-backdrop-filter: blur(12.5rem);
    backdrop-filter: blur(12.5rem);
  }

  /* 1338:2992 was a static code-glyph texture; it is now a live ASCII field read from the photo. */
  .showcase__frame :global(.showcase__ascii) { z-index: -1; opacity: 0.9; }

  /* 1338:2993: 880px glass panel, padding/radius 24.76. */
  .showcase__glass {
    width: 55rem;
    max-width: 100%;
    padding: 1.5475rem;
    border-radius: 1.5475rem;
    background: rgba(255, 255, 255, 0.1);
    -webkit-backdrop-filter: blur(1.29rem);
    backdrop-filter: blur(1.29rem);
  }

  .showcase__shot {
    width: 100%;
    height: auto;
    aspect-ratio: 1920 / 1080;
    object-fit: cover;
  }

  @media (max-width: 1023px) {
    .showcase__frame { aspect-ratio: auto; padding: 3rem 2rem; }
    .showcase__glass { width: 100%; padding: 1rem; border-radius: 1rem; }
  }

  @media (max-width: 767px) {
    .showcase__frame { padding: 1.5rem 0.75rem; }
    .showcase__glass { padding: 0.5rem; border-radius: 0.75rem; }
  }

  /* Tilt + glare (after bencho.dev "Tilt card"): the glass leans away under the pointer,
     a soft highlight follows it and the far side shades a little. Own perspective per card,
     no shared 3D scene. Driven by --rx / --ry / --gx / --gy from the script below. */
  .showcase__glass {
    position: relative;
    transform: perspective(90rem) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transform-origin: 50% 50%;
    will-change: transform;
  }

  .showcase__glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: var(--glare, 0);
    background:
      radial-gradient(
        60% 80% at var(--gx, 50%) var(--gy, 50%),
        rgba(255, 255, 255, 0.4) 0%,
        rgba(255, 255, 255, 0.1) 40%,
        transparent 70%
      ),
      linear-gradient(
        var(--ga, 135deg),
        transparent 45%,
        rgba(0, 0, 0, 0.18) 100%
      );
    mix-blend-mode: soft-light;
    transition: opacity 0.4s var(--ease);
  }
</style>

<script>
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const MAX_X = 6; // deg around the horizontal axis
  const MAX_Y = 8; // deg around the vertical axis

  for (const area of document.querySelectorAll<HTMLElement>('[data-tilt]')) {
    const card = area.querySelector<HTMLElement>('[data-tilt-card]')!;
    let tx = 0, ty = 0, cx = 0, cy = 0; // target / current, −1…1
    let glare = 0, glareT = 0;
    let raf = 0;

    function frame() {
      raf = 0;
      cx += (tx - cx) * 0.12;
      cy += (ty - cy) * 0.12;
      glare += (glareT - glare) * 0.12;
      // The side under the pointer leans away from the viewer.
      card.style.setProperty('--ry', `${(cx * MAX_Y).toFixed(2)}deg`);
      card.style.setProperty('--rx', `${(-cy * MAX_X).toFixed(2)}deg`);
      card.style.setProperty('--gx', `${(50 + cx * 50).toFixed(1)}%`);
      card.style.setProperty('--gy', `${(50 + cy * 50).toFixed(1)}%`);
      card.style.setProperty('--ga', `${(Math.atan2(cy, cx) * 180 / Math.PI + 90 + 180).toFixed(0)}deg`);
      card.style.setProperty('--glare', glare.toFixed(3));
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001 || Math.abs(glareT - glare) > 0.002) {
        raf = requestAnimationFrame(frame);
      }
    }
    const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };

    area.addEventListener('pointermove', (e) => {
      if (!fine.matches || reduce.matches) return;
      const r = card.getBoundingClientRect();
      tx = Math.max(-1, Math.min(1, ((e.clientX - r.left) / r.width) * 2 - 1));
      ty = Math.max(-1, Math.min(1, ((e.clientY - r.top) / r.height) * 2 - 1));
      glareT = 0.95; // "shade 95"
      kick();
    });
    area.addEventListener('pointerleave', () => {
      tx = 0; ty = 0; glareT = 0;
      kick();
    });
  }
</script>
