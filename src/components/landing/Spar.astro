---
import SparFigure from './SparFigure.astro';
import type { SparKind } from '../../lib/spar-figures';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
const kinds: SparKind[] = ['sense', 'plan', 'act', 'reflect'];
---

<section class="spar wrap" id="spar" aria-labelledby="spar-title">
  <div class="spar__head">
    <h2 class="spar__title display" id="spar-title">{d.spar.title}</h2>
    <p class="spar__intro">{d.spar.intro}</p>
  </div>
  <ol class="spar__steps">
    {
      d.spar.steps.map((s, i) => (
        <li class="step" tabindex="0" data-step>
          <div class="step__fig">
            <SparFigure kind={kinds[i]!} />
          </div>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__body">{s.body}</p>
        </li>
      ))
    }
  </ol>
  <p class="spar__statement display">
    <span class="spar__accent">{d.spar.accent}</span>{d.spar.rest}
  </p>
</section>

<style>
  /* Figma SPAR 1338:3025 — py 120, gap 40. */
  .spar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-block: 7.5rem;
  }

  .spar__head {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .spar__title {
    max-width: 51.25rem; /* 820px */
    font-size: 4rem;
    line-height: 1;
    color: var(--c-white);
  }

  .spar__intro {
    max-width: 47.1875rem; /* 755px */
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--c-muted);
    text-wrap: pretty;
  }

  /* 1338:3142 — four 320px tiles, gap 8, text pinned to the bottom. */
  .spar__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .step {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.625rem;
    min-height: 20rem;
    padding: 1.5rem;
    border-radius: 0.5rem;
    background: var(--c-surface-subtle);
  }

  /* Illustration: a faint trace until the tile is hovered or focused (or, on touch, centred on screen). */
  .step { position: relative; outline-offset: 0.25rem; }

  .step__fig {
    margin-bottom: auto;
    padding: 0.5rem 0.5rem 1rem;
    opacity: 0.08; /* a faint trace at rest; full on hover/focus */
    transform: translateY(0.5rem) scale(0.97);
    transition:
      opacity 0.45s var(--ease),
      transform 0.6s var(--ease);
    pointer-events: none;
  }

  .step.is-revealed .step__fig,
  .step:focus-visible .step__fig {
    opacity: 1;
    transform: none;
  }

  .step.is-revealed :global(.iso),
  .step:focus-visible :global(.iso) { --iso-run: running; }

  @media (hover: hover) {
    .step:hover .step__fig { opacity: 1; transform: none; }
    .step:hover :global(.iso) { --iso-run: running; }
  }

  .step { transition: background-color 0.35s var(--ease); }
  @media (hover: hover) {
    .step:hover { background: rgba(255, 255, 255, 0.07); }
  }

  @media (prefers-reduced-motion: reduce) {
    .step__fig { transform: none; }
  }

  .step__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--c-white);
  }

  .step__body {
    font-size: 1.25rem; /* size/body/sm 20 / 24 */
    line-height: 1.5rem;
    color: var(--c-muted);
    text-wrap: pretty;
  }

  .spar__statement {
    font-size: 4rem;
    line-height: 1;
    color: var(--c-white);
  }

  .spar__accent { color: var(--c-gold); }

  @media (max-width: 1023px) {
    .spar { padding-block: 5rem; gap: 2rem; }
    .spar__head { gap: 1.5rem; }
    .spar__title, .spar__statement { font-size: 3rem; }
    .spar__intro { font-size: 1.25rem; }
    .spar__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .step { min-height: 13rem; }
  }

  @media (max-width: 767px) {
    .spar { padding-block: 4rem; }
    .spar__title, .spar__statement { font-size: 2rem; line-height: 1.05; }
    .spar__intro { font-size: 1.125rem; }
    .spar__steps { grid-template-columns: minmax(0, 1fr); }
    .step { min-height: 0; padding: 1.25rem; }
    .step__fig { width: min(100%, 20rem); margin-inline: auto; }
    .step__body { font-size: 1.0625rem; line-height: 1.45; }
  }
</style>

<script>
  // Touch screens have no hover: reveal the tile whose middle crosses the centre band of the screen.
  if (!window.matchMedia('(hover: hover)').matches && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.classList.toggle('is-revealed', e.isIntersecting)),
      { rootMargin: '-35% 0px -35% 0px' },
    );
    document.querySelectorAll('[data-step]').forEach((el) => io.observe(el));
  }
</script>
