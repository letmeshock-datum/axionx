---
/**
 * ASCII field: a live layer of monospace "code" over a photo. Cells light up only
 * where the photo is brightest or most contoured (~amount of the grid), as a density
 * ramp or telemetry lines. Settings mirror the vshslv lab "field" tool:
 * gamma 2.2, "ink" colouring (one ink colour, dim cells lifted towards warm white,
 * lift dim 0.35) and "ripple" motion (the field's edge breathes with slow noise).
 * No pointer interaction. Static for prefers-reduced-motion; paused off-screen.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  amount?: number; // share of cells shown (0–1)
  cell?: number; // cell height in CSS px; width is 0.6 of it
  contour?: number; // 0 = brightness only, 1 = edges only
  gamma?: number; // brightness curve for the field score
  ink?: string; // glyph colour ("ink" mode)
  lift?: number; // cells darker than this are lifted towards warm white
  telemetry?: number; // share of rows that carry telemetry text instead of the ramp
  class?: string;
}
const { src, amount = 0.11, cell = 8, contour = 0.5, gamma = 2.2, ink = '#e8c26a', lift = 0.35, telemetry = 0.25, class: cls = '' } = Astro.props;
const sample = await getImage({ src, width: 720, format: 'webp' });
---

<canvas
  class:list={['ascii', cls]}
  data-ascii
  data-src={sample.src}
  data-amount={amount}
  data-cell={cell}
  data-contour={contour}
  data-gamma={gamma}
  data-ink={ink}
  data-lift={lift}
  data-telemetry={telemetry}
  aria-hidden="true"></canvas>

<style>
  .ascii {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const RAMP = "$@B%8&WM#*oahkbdpqwmZO0QLCJUYXzcvunxrjft/\\|()1{}[]?-_+~<>i!lI;:,\"^`'. ";
  // Anonymised: categories, cities, statuses and numbers only — no proper names.
  const TELEMETRY = [
    '"twin_id":"TWN-RD-00412" "asset":"road segment 07" "city":"Riyadh" "status":"nominal" "condition_score":89 "sensor_temp_c":42.1',
    '"twin_id":"TWN-BLD-01290" "asset":"public pavilion" "city":"Jeddah" "status":"watch" "condition_score":62 "violations_open":7',
    '"twin_id":"TWN-RD-00977" "asset":"arterial road, exit 9" "city":"Dammam" "status":"degraded" "condition_score":44 "detections":19',
    '"series":"coverage_by_region" "coverage":60.5 "window":"Mar–Aug 2026" "source_rows":4812 "lineage":"inspection_reports_daily"',
    '"twin_id":"TWN-BLD-02218" "asset":"office podium" "city":"Riyadh" "status":"nominal" "condition_score":91 "history_points":388',
    '"case":"H-48221" "audit":"tenant" "records":14208 "deployment":"on-prem" "egress_bytes":0 "policy":"saved"',
    '"twin_id":"TWN-BR-00133" "asset":"pedestrian bridge" "city":"Jeddah" "status":"watch" "condition_score":58 "last_inspection":"2026-07-21"',
    '"twin_id":"TWN-PK-00095" "asset":"park lighting, zone 3" "city":"Dammam" "status":"nominal" "condition_score":84 "detections":2',
  ];

  const RIPPLE_SPEED = 0.5; // ripple tempo (1 = original pace; halved on request)

  type Cell = { i: number; c: number; r: number; s: number; col: string; lum: number };

  // Small deterministic value noise.
  const hash = (x: number, y: number) => {
    const h = Math.sin(x * 127.1 + y * 311.7) * 43758.5453;
    return h - Math.floor(h);
  };
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const noise = (x: number, y: number) => {
    const xi = Math.floor(x), yi = Math.floor(y);
    const xf = smooth(x - xi), yf = smooth(y - yi);
    const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
    return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
  };

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const monoFamily = () => getComputedStyle(document.documentElement).getPropertyValue('--font-mono').trim() || 'ui-monospace, Menlo, monospace';

  function field(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d')!;
    const amount = Number(canvas.dataset.amount) || 0.11;
    const cellH = Number(canvas.dataset.cell) || 10;
    const contourMix = Number(canvas.dataset.contour ?? 0.5);
    const gamma = Number(canvas.dataset.gamma) || 2.2;
    const liftDim = Number(canvas.dataset.lift ?? 0.35);
    const inkHex = canvas.dataset.ink || '#e8c26a';
    const INK = [1, 3, 5].map((i) => parseInt(inkHex.slice(i, i + 2), 16));
    const LIFT = [242, 242, 239];
    const telemetryShare = Number(canvas.dataset.telemetry ?? 0.25);
    const cellW = cellH * 0.6;
    const img = new Image();
    img.decoding = 'async';
    img.src = canvas.dataset.src!;

    let cells: Cell[] = [];
    let cols = 0, rows = 0, thr = 0, w = 0, h = 0, dpr = 1;
    let rowLine: Int16Array = new Int16Array(0); // telemetry line per row (−1 = ramp)
    let rowShift: Int16Array = new Int16Array(0);
    let running = false, raf = 0, last = 0, t0 = performance.now();

    function build() {
      const box = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(box.width));
      h = Math.max(1, Math.round(box.height));
      // Cap the backing store for very large canvases (e.g. a full photo behind a parallax strip).
      dpr = Math.min(window.devicePixelRatio || 1, 2, Math.sqrt(4.5e6 / (w * h)));
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      cols = Math.ceil(w / cellW);
      rows = Math.ceil(h / cellH);

      // Sample the photo exactly as object-fit: cover lays it into this box, one pixel per cell.
      const off = document.createElement('canvas');
      off.width = cols;
      off.height = rows;
      const o = off.getContext('2d', { willReadFrequently: true })!;
      const scale = Math.max(w / img.naturalWidth, h / img.naturalHeight);
      const dw = img.naturalWidth * scale, dh = img.naturalHeight * scale;
      o.setTransform(1 / cellW, 0, 0, 1 / cellH, 0, 0);
      o.drawImage(img, (w - dw) / 2, (h - dh) / 2, dw, dh);
      const px = o.getImageData(0, 0, cols, rows).data;

      const lum = new Float32Array(cols * rows);
      for (let k = 0; k < cols * rows; k++) {
        lum[k] = (0.2126 * px[k * 4]! + 0.7152 * px[k * 4 + 1]! + 0.0722 * px[k * 4 + 2]!) / 255;
      }
      // Score = brightness (gamma) mixed with contour strength (gradient magnitude).
      const score = new Float32Array(cols * rows);
      let gmax = 1e-6;
      const grad = new Float32Array(cols * rows);
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        const k = r * cols + c;
        const gx = lum[r * cols + Math.min(c + 1, cols - 1)]! - lum[r * cols + Math.max(c - 1, 0)]!;
        const gy = lum[Math.min(r + 1, rows - 1) * cols + c]! - lum[Math.max(r - 1, 0) * cols + c]!;
        grad[k] = Math.hypot(gx, gy);
        if (grad[k]! > gmax) gmax = grad[k]!;
      }
      for (let k = 0; k < score.length; k++) {
        score[k] = (1 - contourMix) * Math.pow(lum[k]!, gamma) + contourMix * (grad[k]! / gmax);
      }
      // Threshold at the (1 − amount) quantile.
      const sorted = Float32Array.from(score).sort();
      thr = sorted[Math.floor(sorted.length * (1 - amount))] ?? 1;
      const spread = 0.12; // how far the breathing edge can reach
      cells = [];
      for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
        const k = r * cols + c;
        if (score[k]! < thr - spread) continue;
        // Ink: one colour; cells darker than the lift threshold blend towards warm white.
        const L = lum[k]!;
        const a = liftDim > 0 && L < liftDim ? 1 - L / liftDim : 0;
        const col = `rgb(${INK.map((v, j) => Math.round(v + (LIFT[j]! - v) * a)).join(',')})`;
        cells.push({ i: k, c, r, s: score[k]!, col, lum: lum[k]! });
      }
      // A share of the rows carry telemetry text instead of the ramp.
      rowLine = new Int16Array(rows);
      rowShift = new Int16Array(rows);
      for (let r = 0; r < rows; r++) {
        rowLine[r] = hash(r, 7) < telemetryShare ? Math.floor(hash(r, 13) * TELEMETRY.length) : -1;
        rowShift[r] = Math.floor(hash(r, 29) * 200);
      }
      draw(performance.now());
    }

    function draw(now: number) {
      const t = ((now - t0) / 1000) * RIPPLE_SPEED;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);
      ctx.font = `500 ${cellH}px ${monoFamily()}`;
      ctx.textBaseline = 'top';
      const still = reduce.matches;
      for (const cell of cells) {
        // Ripple: the field's edge breathes with slow noise (two layers drifting apart, no net travel).
        const n = still
          ? 0.5
          : (noise(cell.c * 0.06 + t * 0.22, cell.r * 0.12 - t * 0.05) +
              noise(cell.c * 0.06 - t * 0.22 + 17.3, cell.r * 0.12 + t * 0.05 + 4.1)) / 2;
        if (cell.s + (n - 0.5) * 0.24 < thr) continue;
        let ch: string;
        const line = rowLine[cell.r]!;
        if (line >= 0) {
          const text = TELEMETRY[line]!;
          const at = (cell.c + rowShift[cell.r]!) % text.length;
          ch = text[at]!;
          if (ch === ' ') continue;
        } else {
          const idx = Math.floor((1 - cell.lum) * (RAMP.length - 2));
          ch = RAMP[Math.min(Math.max(idx, 0), RAMP.length - 2)]!;
        }
        ctx.fillStyle = cell.col;
        ctx.fillText(ch, cell.c * cellW, cell.r * cellH);
      }
    }

    function loop(now: number) {
      raf = 0;
      if (!running) return;
      if (now - last > 1000 / 24) { last = now; draw(now); } // 24 fps is plenty for drift
      raf = requestAnimationFrame(loop);
    }
    const start = () => { if (!running && !reduce.matches) { running = true; raf = requestAnimationFrame(loop); } };
    const stop = () => { running = false; if (raf) cancelAnimationFrame(raf); raf = 0; };

    const ready = () => {
      build();
      new ResizeObserver(() => build()).observe(canvas);
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(([e]) => (e?.isIntersecting ? start() : stop())).observe(canvas);
      } else start();
      document.fonts?.ready.then(() => draw(performance.now()));
    };
    if (img.complete && img.naturalWidth) ready();
    else img.addEventListener('load', ready, { once: true });
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-ascii]').forEach(field);
</script>
