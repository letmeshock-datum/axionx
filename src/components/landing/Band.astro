---
import { Image } from 'astro:assets';
import landscape from '../../assets/landing/landscape-band.png';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
---

<figure class="band">
  <Image src={landscape} alt={d.band.alt} widths={[768, 1440]} sizes="100vw" class="band__img" format="webp" />
</figure>

<style>
  /* Figma 1338:3058 — full-bleed 320px strip; asset is the node's own 1440 × 320 render (crop baked in). */
  .band {
    position: relative;
    height: 20rem;
    overflow: hidden;
  }

  .band__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .band { height: 13rem; }
  }
</style>
