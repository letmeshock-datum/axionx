---
import { Image } from 'astro:assets';
import landscape from '../../assets/landing/landscape.png';
import AsciiField from './AsciiField.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
---

<!--
  Figma 1338:3058 — full-bleed strip over the dune. The full square photo sits behind the
  strip and slides with the scroll (parallax), revealing sky above and sand below; at the
  middle of its travel it frames the crest as in the design. The ASCII field rides with it.
-->
<figure class="band" data-band>
  <div class="band__media" data-band-media>
    <Image src={landscape} alt={d.band.alt} widths={[800, 1200, 1600]} sizes="100vw" class="band__img" format="webp" />
    <AsciiField src={landscape} amount={0.07} contour={0.6} />
  </div>
</figure>

<style>
  .band {
    position: relative;
    height: 20rem;
    overflow: hidden;
  }

  .band__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    aspect-ratio: 1;
    transform: translate3d(0, calc(var(--py, 0) * -1px), 0);
    will-change: transform;
  }

  .band__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 767px) {
    .band { height: 13rem; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Share of the photo's height where the strip's top edge sits as it enters (lower, sand)
  // and as it leaves (higher, sky): the photo lags the scroll like a distant view through a window.
  const FROM = 0.62;
  const TO = 0.2;

  for (const band of document.querySelectorAll<HTMLElement>('[data-band]')) {
    const media = band.querySelector<HTMLElement>('[data-band-media]')!;
    let ticking = false;

    function update() {
      ticking = false;
      const r = band.getBoundingClientRect();
      const vh = window.innerHeight;
      if (r.bottom < -100 || r.top > vh + 100) return;
      // 0 as the strip enters at the bottom of the screen, 1 as it leaves at the top.
      const p = reduce.matches ? 0.5 : Math.min(Math.max((vh - r.top) / (vh + r.height), 0), 1);
      const imgH = media.offsetHeight;
      const max = Math.max(0, imgH - band.offsetHeight);
      const y = Math.min(max, Math.max(0, imgH * (FROM + (TO - FROM) * p)));
      media.style.setProperty('--py', y.toFixed(1));
    }
    const kick = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };

    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick, { passive: true });
    update();
  }
</script>
