---
import logo from '../../assets/landing/logo-footer.svg';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}
const d = t(Astro.props.locale);
---

<footer class="cta" data-cta>
  <div class="cta__top wrap">
    <h2 class="cta__title display">
      <span>{d.cta.line1}</span>
      <span>{d.cta.line2}</span>
    </h2>
  </div>
  <!-- Frame 43 1338:3129: 203px strip, the 230px wordmark is cropped at the bottom. -->
  <div class="cta__mark" aria-hidden="true">
    <img src={logo.src} width={logo.width} height={logo.height} alt="" class="cta__logo" data-cta-logo />
  </div>
</footer>

<style>
  /* Figma Footer 1338:3124 — pt 240, pb 48. */
  .cta__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 15rem 3rem;
  }

  .cta__title {
    font-size: 6rem; /* 96px */
    line-height: 0.9;
    color: var(--c-white);
    white-space: nowrap;
  }

  .cta__title > span { display: block; }



  /* Full-bleed: sized to the viewport, not the (scaled) rem column. */
  .cta__mark {
    height: calc(100vw * 203 / 1440);
    overflow: hidden;
  }

  /* Rises out of the bottom edge as the page reaches its end (after thedatum.ai's footer). */
  .cta__logo {
    width: calc(100vw * 1417.84 / 1440);
    max-width: none;
    height: auto;
    transform: translate3d(0, calc((1 - var(--rise, 1)) * 72%), 0);
    will-change: transform;
  }

  @media (max-width: 1023px) {
    .cta__top { flex-direction: column; padding-block: 8rem 2.5rem; }
    .cta__title { font-size: 4rem; white-space: normal; }
  }

  @media (max-width: 767px) {
    .cta__top { padding-block: 5rem 2rem; gap: 1.5rem; }
    .cta__title { font-size: 2.5rem; line-height: 0.95; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  for (const cta of document.querySelectorAll<HTMLElement>('[data-cta]')) {
    const logo = cta.querySelector<HTMLElement>('[data-cta-logo]')!;
    let ticking = false;
    function update() {
      ticking = false;
      if (reduce.matches) { logo.style.setProperty('--rise', '1'); return; }
      const vh = window.innerHeight;
      const end = document.documentElement.scrollHeight - vh; // page bottom
      const start = Math.min(end - 1, window.scrollY + cta.getBoundingClientRect().top - vh); // footer enters
      const p = Math.min(Math.max((window.scrollY - start) / Math.max(1, end - start), 0), 1);
      const eased = p * p * (3 - 2 * p); // keeps rising all the way, settles as you land on the bottom
      logo.style.setProperty('--rise', eased.toFixed(4));
    }
    const kick = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick, { passive: true });
    update();
  }
</script>
