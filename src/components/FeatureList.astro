---
import type { Feature } from '../i18n/ui';

interface Props {
  items: Feature[];
  label: string;
}
const { items, label } = Astro.props;
---

<ol class="list" role="list" aria-label={label}>
  {
    items.map((f, i) => (
      <li class="item">
        <span class="item__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="item__text">
          <h3 class="item__title t-trim">{f.title}</h3>
          <p class="item__body">{f.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Hairline above every item, as in the Figma list. */
  .item {
    position: relative;
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    column-gap: 1.875rem; /* 30px */
    padding: 1.5rem 0 1.625rem;
  }

  .item::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: 0;
    height: 1px;
    background: var(--c-line);
  }

  @media (min-resolution: 2dppx) {
    .item::before { height: 0.5px; }
  }

  .item__index {
    font-family: var(--font-mono);
    font-size: 0.8125rem; /* 13px */
    line-height: 1.1875rem; /* centres on the 19px title's first line */
    letter-spacing: 0;
    opacity: 0.6;
  }

  .item__title {
    font-size: 1.1875rem; /* 19px */
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: var(--tr-h);
    text-wrap: balance;
  }

  .item__body {
    max-width: 26rem;
    margin-top: 0.75rem;
    font-size: 0.875rem; /* 14px */
    line-height: 1.5;
    letter-spacing: var(--tr);
    text-wrap: pretty;
    opacity: 0.92;
  }

  :global([dir='rtl']) .item__title { line-height: 1.5; }
  :global([dir='rtl']) .item__body { line-height: 1.8; margin-top: 0.5rem; }

  @media (max-width: 767px) {
    .item { column-gap: 1.25rem; padding: 1.25rem 0 1.375rem; }
    .item__body { max-width: 100%; }
  }
</style>
