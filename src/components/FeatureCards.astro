---
import type { Feature } from '../i18n/ui';

interface Props {
  items: Feature[];
  label: string;
}
const { items, label } = Astro.props;
---

<ol class="cards" role="list" aria-label={label}>
  {
    items.map((f, i) => (
      <li class="card">
        <span class="card__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <div class="card__text">
          <h3 class="card__title t-trim">{f.title}</h3>
          <p class="card__body">{f.body}</p>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Dark glass card: keeps white text legible over every part of the gradient. */
  .card {
    display: flex;
    flex-direction: column;
    gap: 5rem; /* fixed index → title distance keeps titles level across a row */
    padding: 1.5rem 1.5rem 1.625rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 0.75rem;
    background: rgba(8, 8, 8, 0.38);
    -webkit-backdrop-filter: blur(1.25rem);
    backdrop-filter: blur(1.25rem);
  }

  @media (min-resolution: 2dppx) {
    .card { border-width: 0.5px; border-color: rgba(255, 255, 255, 0.2); }
  }

  .card__index {
    font-family: var(--font-mono);
    font-size: 0.8125rem; /* 13px */
    line-height: 1rem;
    letter-spacing: 0;
    color: var(--c-accent);
  }

  .card__title {
    font-size: 1.1875rem; /* 19px */
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: var(--tr-h);
    text-wrap: balance;
  }

  .card__body {
    margin-top: 0.75rem;
    font-size: 0.875rem; /* 14px */
    line-height: 1.5;
    letter-spacing: var(--tr);
    text-wrap: pretty;
    opacity: 0.82;
  }

  :global([dir='rtl']) .card__title { line-height: 1.5; }
  :global([dir='rtl']) .card__body { line-height: 1.8; margin-top: 0.5rem; }

  @media (max-width: 1023px) {
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .card { gap: 3.5rem; }
  }

  @media (max-width: 767px) {
    .cards { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .card { gap: 1.75rem; padding: 1.25rem 1.25rem 1.375rem; }
  }
</style>
