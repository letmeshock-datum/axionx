---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import FeatureSlider from './FeatureSlider.astro';
import Dashboard from './Dashboard.astro';
import Footer from './Footer.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Base locale={locale}>
  <Header locale={locale} />
  <main id="main" class="main">
    <div class="grid">
      <div class="grid__hero"><Hero locale={locale} /></div>
      <div class="grid__media"><Dashboard locale={locale} /></div>
      <div class="grid__features"><FeatureSlider locale={locale} /></div>
    </div>
  </main>
  <Footer locale={locale} />
</Base>

<style>
  .main {
    padding: 8.75rem var(--gutter) 3rem; /* header 50 → hero 190 */
  }

  .grid {
    display: grid;
    grid-template-columns: 31.25rem minmax(0, 1fr); /* 500px | image */
    grid-template-areas:
      'hero media'
      'features media';
    column-gap: 3.75rem;
    row-gap: 6.625rem; /* intro 273 → list 379 */
    align-items: start;
  }

  .grid__hero { grid-area: hero; }
  .grid__features { grid-area: features; }
  .grid__media {
    grid-area: media;
    justify-self: end;
    width: 100%;
    max-width: 50.166rem;
  }

  @media (max-width: 1023px) {
    .main { padding-top: 4.5rem; }
    .grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'hero'
        'media'
        'features';
      row-gap: 2.5rem;
    }
    .grid__media {
      justify-self: stretch;
      max-width: 100%;
    }
  }

  @media (max-width: 767px) {
    .main { padding-top: 3.5rem; padding-bottom: 2rem; }
    .grid { row-gap: 2.25rem; }
  }
</style>
