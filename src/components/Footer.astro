---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const year = String(new Date().getFullYear());
---

<footer class="footer">
  <p class="footer__note t-trim">{d.footer.deployed}</p>
  <p class="footer__copy t-trim">{d.footer.copyright.replace('{year}', year)}</p>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding: 2rem var(--gutter) 0.8125rem; /* label cap-box 957 → 967, frame 980 */
    font-size: 0.875rem;
    line-height: 1.125rem;
    letter-spacing: var(--tr);
  }

  .footer__copy {
    white-space: nowrap;
  }

  @media (max-width: 767px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      padding-bottom: 1.5rem;
    }
    .footer__copy { white-space: normal; }
  }
</style>
