---
import { Picture } from 'astro:assets';
import shot from '../assets/dashboard.webp';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<figure class="dash">
  <Picture
    src={shot}
    widths={[480, 640, 828, 1024, 1300, 1608, 2000]}
    sizes="(min-width: 1024px) 46.6vw, calc(100vw - 2.5rem)"
    formats={['avif']}
    fallbackFormat="webp"
    quality={78}
    alt={d.dashboard.alt}
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="dash__img"
    pictureAttributes={{ class: 'dash__picture' }}
  />
</figure>

<style>
  /* Figma: 802.66 × 451, radius 9.93, alpha mask fading out from 40% to the bottom edge. */
  .dash {
    width: 50.166rem;
    max-width: 100%;
    aspect-ratio: 802.66 / 451;
    border-radius: 0.62rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, rgba(0, 0, 0, 0) 100%);
    mask-image: linear-gradient(to bottom, #000 40%, rgba(0, 0, 0, 0) 100%);
    transform: translateZ(0);
  }

  .dash :global(.dash__picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .dash :global(.dash__img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
</style>
