---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<div class="hero">
  <h1 class="hero__title t-trim">{d.hero.title}</h1>
  <p class="hero__intro t-trim">{d.hero.intro}</p>
</div>

<style>
  .hero__title {
    font-size: 2.5rem; /* 40px */
    font-weight: 400;
    line-height: 1;
    letter-spacing: var(--tr-h);
  }

  .hero__intro {
    max-width: 24.4375rem; /* 391px */
    margin-top: 1.25rem; /* cap-box 218 → 238 */
    font-size: 0.9375rem; /* 15px */
    line-height: 1.6; /* 24px */
    letter-spacing: var(--tr);
    text-wrap: pretty;
  }

  :global([dir='rtl']) .hero__intro {
    line-height: 1.8;
    margin-top: 1rem;
  }

  @media (max-width: 1023px) {
    .hero__intro { max-width: 28rem; }
  }

  @media (max-width: 767px) {
    .hero__title { font-size: 2.25rem; }
    .hero__intro { max-width: 100%; margin-top: 1rem; }
  }
</style>
