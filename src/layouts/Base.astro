---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { SITE } from '../site.config';
import { locales, localeMeta, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
}

const { locale } = Astro.props;
const d = t(locale);
const meta = localeMeta[locale];
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;
const ogImage = new URL(Astro.props.ogImage ?? `/og/og-${locale}.jpg`, SITE.shareOrigin);

const canonical = getAbsoluteLocaleUrl(locale, '/');
const alternates = locales.map((l) => ({
  locale: l,
  hreflang: localeMeta[l].hreflang,
  href: getAbsoluteLocaleUrl(l, '/'),
}));
const xDefault = getAbsoluteLocaleUrl('en', '/');

// The other language's page is prefetched so the switch lands on a warm cache.
const otherLocales = locales.filter((l) => l !== locale);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      logo: { '@type': 'ImageObject', url: new URL('/icons/icon-512.png', Astro.site).href },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: locales.map((l) => localeMeta[l].htmlLang),
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: meta.htmlLang,
      isPartOf: { '@id': `${SITE.url}/#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.href },
    },
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir} data-mail-subject={d.mail.subject}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={d.meta.ogAlt} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-geist-mono" preload />
    <!-- Noto Kufi Arabic loads on every page (the switch's «عربي» label uses it), so /ar opens with it cached. -->
    <Font cssVariable="--font-arabic" preload={locale === 'ar'} />
    {otherLocales.map((l) => <link rel="prefetch" href={getRelativeLocaleUrl(l, '/')} />)}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <!-- Arriving through the language wipe: stay covered from the first frame (src/lib/wipe.ts). -->
    <script is:inline>
      try {
        const note = JSON.parse(sessionStorage.getItem('axion:wipe') || 'null');
        sessionStorage.removeItem('axion:wipe');
        if (note && Date.now() - note.t < 5000 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.dataset.wipe = String(note.s);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <div class="page">
      <slot />
    </div>
    <div class="mail-menu" data-mail-menu role="dialog" aria-label={d.mail.label} hidden>
      <p class="mail-menu__to" data-mail-to></p>
      <a class="mail-menu__item" data-mail-app>{d.mail.app}</a>
      <a class="mail-menu__item" data-mail-gmail target="_blank" rel="noopener">Gmail</a>
      <a class="mail-menu__item" data-mail-outlook target="_blank" rel="noopener">Outlook</a>
      <button class="mail-menu__item" type="button" data-mail-copy data-copied={d.mail.copied}>{d.mail.copy}</button>
    </div>
  </body>
</html>

<script>
  import { wipeIn } from '../lib/wipe';
  wipeIn();
</script>

<script>
  // A bare mailto: link depends on the visitor's OS/browser handler and often
  // does nothing, so mail links open a small menu: mail app, Gmail, Outlook,
  // or copy the address.
  const menu = document.querySelector<HTMLElement>('[data-mail-menu]')!;
  const to = menu.querySelector<HTMLElement>('[data-mail-to]')!;
  const app = menu.querySelector<HTMLAnchorElement>('[data-mail-app]')!;
  const gmail = menu.querySelector<HTMLAnchorElement>('[data-mail-gmail]')!;
  const outlook = menu.querySelector<HTMLAnchorElement>('[data-mail-outlook]')!;
  const copyBtn = menu.querySelector<HTMLButtonElement>('[data-mail-copy]')!;
  const copyLabel = copyBtn.textContent ?? '';
  const subject = encodeURIComponent(document.documentElement.dataset.mailSubject ?? '');
  let opener: HTMLElement | null = null;
  let address = '';

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = Object.assign(document.createElement('textarea'), { value: text });
      area.style.cssText = 'position:fixed;opacity:0';
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  };

  const place = () => {
    if (!opener) return;
    const r = opener.getBoundingClientRect();
    const m = menu.getBoundingClientRect();
    const gap = 8;
    const below = r.bottom + gap + m.height <= innerHeight;
    const top = below ? r.bottom + gap : r.top - gap - m.height;
    const left = Math.min(Math.max(16, r.left + r.width / 2 - m.width / 2), innerWidth - 16 - m.width);
    menu.style.top = `${Math.max(16, top)}px`;
    menu.style.left = `${left}px`;
  };

  const close = () => {
    if (menu.hidden) return;
    menu.hidden = true;
    opener?.setAttribute('aria-expanded', 'false');
    opener = null;
  };

  const open = (link: HTMLAnchorElement) => {
    address = decodeURIComponent(link.href.slice(7).split('?')[0]);
    const to_ = encodeURIComponent(address);
    to.textContent = address;
    app.href = `mailto:${address}?subject=${subject}`;
    gmail.href = `https://mail.google.com/mail/?view=cm&fs=1&to=${to_}&su=${subject}`;
    outlook.href = `https://outlook.office.com/mail/deeplink/compose?to=${to_}&subject=${subject}`;
    copyBtn.textContent = copyLabel;
    opener = link;
    link.setAttribute('aria-expanded', 'true');
    menu.hidden = false;
    place();
    app.focus({ preventScroll: true });
  };

  document.addEventListener('click', (e) => {
    const target = e.target as Element;
    if (menu.contains(target)) {
      if (target.closest('[data-mail-copy]')) {
        copy(address);
        copyBtn.textContent = copyBtn.dataset.copied ?? '';
      } else if (target.closest('a')) {
        setTimeout(close, 0);
      }
      return;
    }
    const link = target.closest<HTMLAnchorElement>('a[href^="mailto:"]');
    if (!link) return close();
    e.preventDefault();
    if (opener === link) return close();
    open(link);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || menu.hidden) return;
    const back = opener;
    close();
    back?.focus();
  });
  addEventListener('scroll', close, { passive: true });
  addEventListener('resize', close);
</script>

<style>
  .mail-menu {
    position: fixed;
    z-index: 30;
    display: flex;
    flex-direction: column;
    min-width: 13.5rem;
    padding: 0.375rem;
    border: 1px solid var(--c-border);
    border-radius: 0.75rem;
    background: rgba(14, 14, 14, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.5);
    animation: mail-in 0.18s var(--ease);
  }
  .mail-menu[hidden] { display: none; }

  @keyframes mail-in {
    from { opacity: 0; transform: translateY(-0.25rem); }
  }

  .mail-menu__to {
    margin: 0;
    padding: 0.5rem 0.75rem 0.625rem;
    border-bottom: 1px solid var(--c-border-subtle);
    margin-bottom: 0.25rem;
    color: var(--c-dim);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .mail-menu__item {
    display: block;
    width: 100%;
    padding: 0.625rem 0.75rem;
    border: 0;
    border-radius: 0.5rem;
    background: none;
    color: var(--c-text);
    font: inherit;
    font-size: 0.9375rem;
    text-align: start;
    text-decoration: none;
    cursor: pointer;
  }
  .mail-menu__item:hover,
  .mail-menu__item:focus-visible {
    background: var(--c-surface-muted);
    outline: none;
  }

  .skip-link {
    position: absolute;
    inset-inline-start: var(--gutter);
    top: -100%;
    z-index: 10;
    padding: 0.5rem 0.9375rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: #080808;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .skip-link:focus-visible {
    top: 0.5rem;
  }
</style>
