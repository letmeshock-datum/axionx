---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { SITE } from '../site.config';
import { locales, localeMeta, t, type Locale } from '../i18n/ui';
import Background from '../components/Background.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
}

const { locale } = Astro.props;
const d = t(locale);
const meta = localeMeta[locale];
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;
const ogImage = new URL(Astro.props.ogImage ?? `/og/og-${locale}.jpg`, Astro.site);

const canonical = getAbsoluteLocaleUrl(locale, '/');
const alternates = locales.map((l) => ({
  locale: l,
  hreflang: localeMeta[l].hreflang,
  href: getAbsoluteLocaleUrl(l, '/'),
}));
const xDefault = getAbsoluteLocaleUrl('en', '/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      logo: { '@type': 'ImageObject', url: new URL('/icons/icon-512.png', Astro.site).href },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: locales.map((l) => localeMeta[l].htmlLang),
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: meta.htmlLang,
      isPartOf: { '@id': `${SITE.url}/#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.href },
    },
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={d.meta.ogAlt} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" preload />
    {locale === 'ar' && <Font cssVariable="--font-arabic" preload />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <Background />
    <div class="page">
      <slot />
    </div>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    inset-inline-start: var(--gutter);
    top: -100%;
    z-index: 10;
    padding: 0.5rem 0.9375rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: #080808;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .skip-link:focus-visible {
    top: 0.5rem;
  }
</style>
