---
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '../styles/global.css';
import { SITE } from '../site.config';
import { locales, localeMeta, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  ogImage?: string;
}

const { locale } = Astro.props;
const d = t(locale);
const meta = localeMeta[locale];
const title = Astro.props.title ?? d.meta.title;
const description = Astro.props.description ?? d.meta.description;
const ogImage = new URL(Astro.props.ogImage ?? `/og/og-${locale}.jpg`, Astro.site);

const canonical = getAbsoluteLocaleUrl(locale, '/');
const alternates = locales.map((l) => ({
  locale: l,
  hreflang: localeMeta[l].hreflang,
  href: getAbsoluteLocaleUrl(l, '/'),
}));
const xDefault = getAbsoluteLocaleUrl('en', '/');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      email: SITE.email,
      logo: { '@type': 'ImageObject', url: new URL('/icons/icon-512.png', Astro.site).href },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      inLanguage: locales.map((l) => localeMeta[l].htmlLang),
      publisher: { '@id': `${SITE.url}/#organization` },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: meta.htmlLang,
      isPartOf: { '@id': `${SITE.url}/#website` },
      primaryImageOfPage: { '@type': 'ImageObject', url: ogImage.href },
    },
  ],
};
---

<!doctype html>
<html lang={meta.htmlLang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:secure_url" content={ogImage.href} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={meta.ogLocale} />
    {locales
      .filter((l) => l !== locale)
      .map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={d.meta.ogAlt} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-geist-mono" preload />
    {locale === 'ar' && <Font cssVariable="--font-arabic" preload />}

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{d.a11y.skip}</a>
    <div class="page">
      <slot />
    </div>
    <div class="mail-toast" data-mail-toast data-copied={d.cta.copied} role="status" aria-live="polite"></div>
  </body>
</html>

<script>
  // mailto: does nothing when no mail app is set up, so every mail link also
  // copies the address and says so.
  const toast = document.querySelector<HTMLElement>('[data-mail-toast]');
  let hide = 0;

  const copy = async (text: string) => {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const area = Object.assign(document.createElement('textarea'), { value: text });
      area.style.cssText = 'position:fixed;opacity:0';
      document.body.append(area);
      area.select();
      document.execCommand('copy');
      area.remove();
    }
  };

  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="mailto:"]');
    if (!link || !toast) return;
    const address = decodeURIComponent(link.href.slice(7).split('?')[0]);
    copy(address);
    toast.textContent = `${address} · ${toast.dataset.copied}`;
    toast.classList.add('is-on');
    clearTimeout(hide);
    hide = window.setTimeout(() => toast.classList.remove('is-on'), 3200);
  });
</script>

<style>
  .mail-toast {
    position: fixed;
    inset-inline: 0;
    bottom: 1.5rem;
    z-index: 20;
    width: max-content;
    max-width: calc(100% - 2rem);
    margin-inline: auto;
    padding: 0.75rem 1.125rem;
    border: 1px solid var(--c-accent-border);
    border-radius: 0.5rem;
    background: rgba(12, 12, 12, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--c-text);
    font-size: 0.9375rem;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .mail-toast.is-on {
    opacity: 1;
    transform: none;
  }

  .skip-link {
    position: absolute;
    inset-inline-start: var(--gutter);
    top: -100%;
    z-index: 10;
    padding: 0.5rem 0.9375rem;
    border-radius: 999px;
    background: var(--c-accent);
    color: #080808;
    font-size: 0.875rem;
    text-decoration: none;
  }
  .skip-link:focus-visible {
    top: 0.5rem;
  }
</style>
